# --- WEB (Vercel > Settings > Environment Variables) ---
# Địa chỉ server realtime đã deploy riêng (https, KHÔNG có dấu / ở cuối). Đổi xong phải deploy lại web.
NEXT_PUBLIC_SERVER_URL=https://kho-game-server.onrender.com

# --- SERVER (Render / Railway / Fly.io) ---
# Địa chỉ web được phép kết nối, ngăn cách bằng dấu phẩy, hỗ trợ ký tự *
CLIENT_ORIGIN=https://kho-game.vercel.app,https://*.vercel.app
# PORT do nền tảng hosting tự cấp
