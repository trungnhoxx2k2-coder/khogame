{
  "name": "cotuong-online",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,server -c green,blue \"next dev\" \"tsx watch server/index.ts\"",
    "build": "next build",
    "start": "concurrently -n web,server \"next start\" \"tsx server/index.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/engine.test.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "start:server": "tsx server/index.ts",
    "dev:server": "tsx watch server/index.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.18"
  }
}
